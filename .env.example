LAPS_API_KEY=your_api_key
LAPS_API_SECRET=your_api_secret
LAPS_SANDBOX=true

# Primary and fallback symbols (first is preferred).
LAPS_SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT,DOGE/USDT:USDT,XRP/USDT:USDT,ADA/USDT:USDT
LAPS_SCAN_ALL_SYMBOLS=true
LAPS_MAX_SCAN_SYMBOLS=300
LAPS_SYMBOL_UNIVERSE_REFRESH_SECONDS=900

# Strategy settings
LAPS_TIMEFRAME=15m
LAPS_FAST_MA=12
LAPS_SLOW_MA=26
LAPS_MAX_POSITIONS=30
LAPS_BALANCE_RISK_PCT=1
LAPS_FIXED_ENTRY_MARGIN_USDT=0.10
LAPS_LEVERAGE=125
LAPS_USE_MAX_LEVERAGE_PER_SYMBOL=true
LAPS_TARGET_ROI_PCT=100
LAPS_ADD_MARGIN_TRIGGER_PCT=-60
LAPS_MARGIN_RATIO_TRIGGER_PCT=60
LAPS_MARGIN_MATCH_TOLERANCE_PCT=0.25
LAPS_TAKER_FEE_RATE=0.0005
LAPS_REINFORCEMENT_MULTIPLIER=3

# Rebalance policy
LAPS_SPOT_TARGET_PCT=80
LAPS_FUTURES_TARGET_PCT=20
LAPS_MARGIN_TOPUP_PCT=20
LAPS_MAX_TOPUPS=4

# Runtime
LAPS_POLL_SECONDS=20
LAPS_ENTRY_SCAN_BATCH=300
LAPS_LOG_LEVEL=INFO
LAPS_TELEMETRY_DIR=runtime
LAPS_PANEL_HOST=0.0.0.0
LAPS_PANEL_PORT=8080
